# ==========================================================================
# Plantilla de variables de entorno - CIE-10 Classifier
# --------------------------------------------------------------------------
# Copia este fichero a ".env" y rellena los valores reales.
# El fichero ".env" está excluido del control de versiones (.gitignore) para
# que NUNCA se suban secretos reales a GitHub.
# ==========================================================================

# --------------------------------------------------------------------------
# Vertex AI (servicio llm-query-processor)
# --------------------------------------------------------------------------
# ID del proyecto de Google Cloud. Si se monta el fichero de credenciales
# (service account JSON), el ID del proyecto se toma de dicho fichero y esta
# variable es opcional.
ID=tu-proyecto-gcp
# Región de Vertex AI.
LOCATION=europe-west1

# --------------------------------------------------------------------------
# Autenticación (JWT) - OBLIGATORIO
# --------------------------------------------------------------------------
# Secreto para firmar los tokens JWT. Es OBLIGATORIO y los servicios no
# arrancarán si no está definido. Usa un valor aleatorio y largo, p. ej.:
#   openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --------------------------------------------------------------------------
# Base de datos (MongoDB) - OBLIGATORIO
# --------------------------------------------------------------------------
# Cadena de conexión a MongoDB. Para una instancia local:
#   mongodb://localhost:27017/clinic-classifier
# Para MongoDB Atlas usa la cadena "mongodb+srv://usuario:password@cluster/...".
MONGO_CONNECTION=mongodb://localhost:27017/clinic-classifier
